# Copy to .env on your own machine or server. Never commit .env.
# Values below are placeholders only.

# Trading mode. Only "paper" exists; there is no live-order adapter.
TRADING_MODE=paper
STARTING_CAPITAL_INR=100000

# AI news classification: deepseek | glm | disabled
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=

# Telegram alerts (create a bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upstox market data (read-only; access token expires daily at 03:30 IST)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
